# Database
DATABASE_URL="postgresql://dev:dev123@localhost:5432/urbanplanner"
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev123
POSTGRES_DB=urbanplanner

# Redis
REDIS_URL="redis://localhost:6379"

# Storage (MinIO for dev, S3 for production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=urbanplanner-files
S3_REGION=us-east-1

# API Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production

# Mapping Services
MAPBOX_TOKEN=pk.your_mapbox_token_here
MAPTILER_KEY=your_maptiler_key_here
GEOCODING_API_KEY=your_geocoding_key_here

# Transit Data
TRANSITLAND_API_KEY=your_transitland_key_here

# Census Data
CENSUS_API_KEY=your_census_api_key_here

# Frontend
VITE_API_URL=http://localhost:3000
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
VITE_WS_URL=ws://localhost:3000

# Python Services (for ML/forecasting)
PYTHON_SERVICE_URL=http://localhost:8000

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload Limits
MAX_FILE_SIZE=100MB
MAX_GTFS_SIZE=500MB

# Feature Flags
ENABLE_REALTIME_COLLABORATION=false
ENABLE_ML_FORECASTING=true
ENABLE_3D_VISUALIZATION=true
