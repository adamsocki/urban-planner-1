{
  "name": "@urban-planner/forecasting",
  "version": "0.1.0",
  "description": "Ridership forecasting models and analysis tools for transit planning",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
